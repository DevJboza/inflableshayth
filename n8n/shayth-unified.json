{
  "name": "Inflables Shayth | Campanas + Gmail + Catalogo PDF + Respuestas",
  "nodes": [
    {
      "id": "schedule",
      "name": "Cada minuto · control automático",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "claim",
      "name": "Reclamar trabajos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [250, 0],
      "parameters": {
        "method": "POST",
        "url": "https://inflableshayth.vercel.app/api/n8n/jobs/claim",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{\"limit\":1}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Vwe1esTrAZIXOdJK",
          "name": "Shayth API"
        }
      }
    },
    {
      "id": "split",
      "name": "Separar trabajos",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [500, 0],
      "parameters": {
        "fieldToSplitOut": "jobs"
      }
    },
    {
      "id": "gmail",
      "name": "Enviar con Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "onError": "continueErrorOutput",
      "position": [1070, 0],
      "parameters": {
        "sendTo": "={{ $('Separar trabajos').item.json.email }}",
        "subject": "={{ $('Separar trabajos').item.json.subject }}",
        "emailType": "html",
        "message": "={{String($(\"Separar trabajos\").item.json.html || \"\").replaceAll(\"\\u007b\\u007binstitucion\\u007d\\u007d\",String($(\"Separar trabajos\").item.json.institution || \"\")).replaceAll(\"\\u007b\\u007bcontacto\\u007d\\u007d\",String($(\"Separar trabajos\").item.json.contact || \"\")).replaceAll(\"\\u007b\\u007bprovincia\\u007d\\u007d\",String($(\"Separar trabajos\").item.json.province || \"\")).replaceAll(\"\\u007b\\u007bempresa\\u007d\\u007d\",\"Inflables Shayth\")}}",
        "options": {
          "appendAttribution": false,
          "senderName": "Inflables Shayth",
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "catalogo"
              }
            ]
          }
        },
        "resource": "message",
        "operation": "send"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "eP8PRBsZMqkEKSK2",
          "name": "Gmail account 2"
        }
      },
      "webhookId": "66c550d6-8f2a-46e7-98f5-acbf1c77de63"
    },
    {
      "id": "report",
      "name": "Reportar enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 0],
      "parameters": {
        "method": "POST",
        "url": "https://inflableshayth.vercel.app/api/n8n/jobs/report",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({jobId: $('Separar trabajos').item.json.id, status: 'sent', gmailMessageId: $json.id, gmailThreadId: $json.threadId})}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Vwe1esTrAZIXOdJK",
          "name": "Shayth API"
        }
      }
    },
    {
      "id": "gmail-trigger",
      "name": "Nuevas respuestas Gmail",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 460],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "q": "in:inbox newer_than:7d"
        },
        "simple": false
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "omW1M6LlZwSt8WPq",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "post",
      "name": "Registrar respuesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 460],
      "parameters": {
        "method": "POST",
        "url": "https://inflableshayth.vercel.app/api/n8n/replies",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({gmailMessageId:$json.id,threadId:$json.threadId,from:(typeof $json.from === \"string\" ? $json.from : $json.from?.value?.[0]?.address) || $json.From || $json.headers?.from || \"\",subject:$json.subject || $json.Subject || $json.headers?.subject || \"(Sin asunto)\",bodyText:$json.textPlain || $json.text || $json.body?.text || $json.snippet || \"\",receivedAt:new Date($json.date || $json.headers?.date || Date.now()).toISOString()})}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Vwe1esTrAZIXOdJK",
          "name": "Shayth API"
        }
      }
    },
    {
      "id": "report-failed",
      "name": "Reportar error de envío",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 220],
      "parameters": {
        "method": "POST",
        "url": "https://inflableshayth.vercel.app/api/n8n/jobs/report",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({jobId:$(\"Separar trabajos\").item.json.id,status:\"failed\",error:String(typeof $json.error === \"string\" ? $json.error : ($json.error?.message || $json.message || \"Error en Gmail\"))})}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Vwe1esTrAZIXOdJK",
          "name": "Shayth API"
        }
      }
    },
    {
      "id": "note-send",
      "name": "Guía · campañas",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -420],
      "parameters": {
        "content": "## 1 · CAMPAÑAS + CATÁLOGO NAVIDEÑO ADJUNTO\n\nPrimero subir `Catalogo_Navideno_Inflables_Shayth.pdf` al directorio `public/catalogo-navideno.pdf` del proyecto Next.js desplegado en Vercel.\n\nComprobar que `https://TU-VERCEL/catalogo-navideno.pdf` devuelve el PDF (no HTML, ni login).\n\nEnviar: n8n reclama 1 trabajo cada 10 min, descarga el catálogo como binario `catalogo`, envía con Gmail y reporta éxito/error al backend.\n\n**Antes de activar**: configurar `SHAYTH_APP_URL`, `SHAYTH_INTEGRATION_SECRET`, conectar la credencial Gmail y hacer un envío de prueba a cuenta propia.\n\nNo activar simultáneamente el workflow anterior.",
        "height": 220,
        "width": 680
      }
    },
    {
      "id": "note-replies",
      "name": "Guía · respuestas",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, 670],
      "parameters": {
        "content": "## 2 · RESPUESTAS ENTRANTES\nLee nuevos correos de Gmail y envía sus datos a `/api/n8n/replies`.\n\nLa API de la PWA debe vincular cada mensaje a una campaña y descartar los que no correspondan.\n\n**Atención:** no ejecutar en paralelo el antiguo workflow `gmail-replies.json`.",
        "height": 205,
        "width": 620
      }
    },
    {
      "id": "shayth-download-catalogue-2026",
      "name": "Descargar catálogo navideño (PDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [780, 0],
      "parameters": {
        "method": "GET",
        "url": "={{'https://inflableshayth.vercel.app' + ($('Separar trabajos').item.json.catalog_path || '/catalogo-navideno.pdf')}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "catalogo"
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "shayth-report-catalogue-download-error-2026",
      "name": "Reportar error del catálogo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1070, 220],
      "parameters": {
        "method": "POST",
        "url": "https://inflableshayth.vercel.app/api/n8n/jobs/report",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({jobId: $('Separar trabajos').item.json.id, status: 'failed', error: 'No se pudo descargar el catálogo PDF: ' + String($json.error?.message || $json.message || 'error desconocido')})}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Vwe1esTrAZIXOdJK",
          "name": "Shayth API"
        }
      }
    }
  ],
  "connections": {
