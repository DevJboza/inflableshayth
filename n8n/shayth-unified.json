        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({gmailMessageId:$json.id,threadId:$json.threadId,from:(typeof $json.from === \"string\" ? $json.from : $json.from?.value?.[0]?.address) || $json.From || $json.headers?.from || \"\",subject:$json.subject || $json.Subject || $json.headers?.subject || \"(Sin asunto)\",bodyText:$json.textPlain || $json.text || $json.body?.text || $json.snippet || \"\",receivedAt:new Date($json.date || $json.headers?.date || Date.now()).toISOString()})}}",
        "options": {}
